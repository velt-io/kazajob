{
  "name": "kazajob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env.local --test src/lib/launch.test.ts src/lib/entitlements.test.ts src/lib/skills.test.ts src/lib/cv.test.ts src/lib/password-reset.test.ts src/lib/job-lifecycle.test.ts src/lib/ai/provider.test.ts src/lib/rate-limit.test.ts src/lib/email-verification.test.ts src/lib/quest-journey.test.ts",
    "db:migrate:launch": "tsx --env-file=.env.local src/lib/db/migrate-kazalaunch.ts",
    "db:migrate:job-lifecycle": "tsx --env-file=.env.local src/lib/db/migrate-job-lifecycle.ts",
    "db:migrate:auth-rate-limits": "tsx --env-file=.env.local src/lib/db/migrate-auth-rate-limits.ts",
    "db:migrate:email-verifications": "tsx --env-file=.env.local src/lib/db/migrate-email-verifications.ts",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "db:seed:admin": "tsx --env-file=.env.local src/lib/db/seed-admin.ts",
    "db:seed:demo": "tsx --env-file=.env.local src/lib/db/seed-demo.ts",
    "db:backup": "tsx --env-file=.env.local -e \"import('./src/lib/db/backup-export').then(m=>m.exportBackup()).then(r=>console.log(r.file,r.total,'lignes'))\"",
    "db:reset:launch:dry": "tsx --env-file=.env.local scripts/reset-launch-database.ts --dry-run",
    "db:reset:launch": "tsx --env-file=.env.local scripts/reset-launch-database.ts"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.187.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
